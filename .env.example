# ===== 模型接入（OpenAI 兼容端点，二选一）=====
# 默认：中国科大端点（本机实测 function calling 正常，key 有 20 RPM 限流）
OPENAI_API_BASE=https://api.llm.ustc.edu.cn/v1
OPENAI_API_KEY=sk-replace-me
AGENT_MODEL=qwen3.8-chat

# 备选：阿里云百炼（无 20 RPM 限制，切过来只需改这三行）
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-replace-me
# AGENT_MODEL=qwen3.8-flash

# ===== 限速与预算 =====
# 两次模型调用之间的最小间隔（秒）。USTC 端点 key 上限 20 RPM ≈ 3.2s/次；
# 百炼可设为 0。
AGENT_MIN_INTERVAL=3.2
# 单次运行允许的最大循环步数与最大工具调用次数，超限返回 incomplete。
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=16
# 单次模型调用超时（秒）
AGENT_TIMEOUT=60

# ===== 故障注入（只用于演示「保存失败」路径，正常留空）=====
# 取值 save 表示草稿写盘必失败
SCHEDULER_FAULT=
